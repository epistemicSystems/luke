# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id

# OpenAI Configuration
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4-turbo-preview
EMBEDDING_MODEL=text-embedding-3-large

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=insight_graph

# Graph Storage
GRAPH_DATA_DIR=./data/graph

# RAG Configuration
RAG_TOP_K=10
RAG_CONTEXT_WINDOW=8000

# Persona Configuration
PERSONAS_DIR=./insight_graph/personas/profiles

# Brief Configuration
BRIEF_CHANNEL_ID=your_brief_channel_id
BRIEF_SCHEDULE_HOUR=9  # 9 AM daily brief

# Privacy
ENABLE_PII_REDACTION=true
MIN_COHORT_SIZE=5  # k-anonymity threshold

# Logging
LOG_LEVEL=INFO
